import pytest

from pages.catalog_page import CatalogPage


def test_catalog_page_opens(browser):
    page = CatalogPage(browser)
    page.open_page()

    assert page.has_catalog_content()


def test_main_filters_are_visible_by_default(browser):
    page = CatalogPage(browser)
    page.open_page()

    assert page.has_filter_title("Стоимость")
    assert page.has_filter_title("Продолжительность")
    assert page.has_filter_title("Место проведения")


def test_show_more_button_is_available(browser):
    page = CatalogPage(browser)
    page.open_page()

    assert page.show_more_buttons()


def test_show_more_expands_filter_values(browser):
    page = CatalogPage(browser)
    page.open_page()
    before, after = page.click_first_show_more()

    assert before != after or "Показать меньше" in after


@pytest.mark.xfail(reason="Known bug: invalid price range is shown in the catalog filter")
def test_price_filter_has_no_invalid_range(browser):
    page = CatalogPage(browser)
    page.open_page()

    assert not page.has_invalid_price_range()


@pytest.mark.xfail(reason="Known bug: broken 'show more/show less' button text")
def test_show_more_button_text_is_correct(browser):
    page = CatalogPage(browser)
    page.open_page()

    assert not page.has_broken_show_more_text()
